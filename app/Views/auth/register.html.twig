{% extends 'layouts/base.html.twig' %}

{% block title %}Registracija — {{ app_name }}{% endblock %}

{% block body %}
<div class="min-vh-100 d-flex align-items-center justify-content-center bg-light">
    <div class="card shadow" style="width: 480px;">

        <div class="card-header bg-primary text-white text-center py-4">
            <h4 class="mb-0">
                <i class="bi bi-hospital me-2"></i>{{ app_name }}
            </h4>
            <small>Kreiranje novog naloga</small>
        </div>

        <div class="card-body p-4">

            {% if flash.error %}
                <div class="alert alert-danger">{{ flash.error }}</div>
            {% endif %}

            <form action="{{ app_url }}/register" method="POST">

                <div class="row">
                    <div class="col mb-3">
                        <label class="form-label">Ime</label>
                        <input type="text" name="first_name" class="form-control" 
                               placeholder="Vaše ime" required>
                    </div>
                    <div class="col mb-3">
                        <label class="form-label">Prezime</label>
                        <input type="text" name="last_name" class="form-control" 
                               placeholder="Vaše prezime" required>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Email adresa</label>
                    <input type="email" name="email" class="form-control" 
                           placeholder="vasa@email.com" required>
                </div>

                <div class="mb-3">
                    <label class="form-label">Lozinka</label>
                    <input type="password" name="password" class="form-control" 
                           placeholder="Minimum 8 karaktera" required>
                </div>

                <div class="mb-3">
                    <label class="form-label">Potvrda lozinke</label>
                    <input type="password" name="confirm_password" class="form-control" 
                           placeholder="Ponovite lozinku" required>
                </div>

                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-person-plus me-1"></i> Registruj se
                </button>

            </form>
        </div>

        <div class="card-footer text-center text-muted">
            Već imate nalog? 
            <a href="{{ app_url }}/login">Prijavite se</a>
        </div>

    </div>
</div>
{% endblock %}