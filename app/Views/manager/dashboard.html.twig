{% extends 'layouts/manager.html.twig' %}

{% block page_title %}Dashboard{% endblock %}

{% block content %}

<div class="row g-4 mb-4">

    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle bg-success bg-opacity-10 p-3">
                    <i class="bi bi-calendar-check text-success fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small">Termini danas</div>
                    <div class="fs-4 fw-bold">{{ stats.termini_danas }}</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle bg-warning bg-opacity-10 p-3">
                    <i class="bi bi-hourglass-split text-warning fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small">Na čekanju</div>
                    <div class="fs-4 fw-bold">{{ stats.termini_pending }}</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle bg-info bg-opacity-10 p-3">
                    <i class="bi bi-person-heart text-info fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small">Pacijenti</div>
                    <div class="fs-4 fw-bold">{{ stats.pacijenti }}</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle bg-primary bg-opacity-10 p-3">
                    <i class="bi bi-envelope text-primary fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small">Nepročitane poruke</div>
                    <div class="fs-4 fw-bold">{{ stats.poruke_neprocitane }}</div>
                </div>
            </div>
        </div>
    </div>

</div>

{# Skora na čekanju #}
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white fw-semibold">
        <i class="bi bi-hourglass-split me-2 text-warning"></i>Termini koji čekaju potvrdu
    </div>
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Pacijent</th>
                    <th>Lekar</th>
                    <th>Datum i vreme</th>
                    <th>Razlog</th>
                    <th class="text-end">Akcija</th>
                </tr>
            </thead>
            <tbody>
                {% for t in skorasnji %}
                <tr>
                    <td>{{ t.patient_name }}</td>
                    <td>{{ t.doctor_name }}</td>
                    <td>{{ t.scheduled_at|date('d.m.Y H:i') }}</td>
                    <td>{{ t.reason ?? '—' }}</td>
                    <td class="text-end">
                        <form action="{{ app_url }}/manager/termini/{{ t.id }}/status" method="POST" class="d-inline">
                            <input type="hidden" name="status" value="confirmed">
                            <button class="btn btn-sm btn-success">
                                <i class="bi bi-check-lg"></i> Potvrdi
                            </button>
                        </form>
                    </td>
                </tr>
                {% else %}
                <tr><td colspan="5" class="text-center text-muted py-4">Nema termina na čekanju.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% if skorasnji|length > 0 %}
    <div class="card-footer bg-white">
        <a href="{{ app_url }}/manager/termini?status=pending" class="btn btn-sm btn-outline-warning">
            Prikaži sve na čekanju
        </a>
    </div>
    {% endif %}
</div>

{% endblock %}
