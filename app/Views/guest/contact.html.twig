{% extends 'layouts/guest.html.twig' %}

{% block title %}Kontakt — {{ app_name }}{% endblock %}

{% block content %}

<div class="bg-primary text-white py-5">
    <div class="container text-center">
        <h1 class="fw-bold">Kontakt</h1>
        <p class="lead">Stupite u kontakt sa nama</p>
    </div>
</div>

<div class="container py-5">

    <div class="row g-5">

        {# Kontakt informacije #}
        <div class="col-md-5">
            <h4 class="fw-bold mb-4">Informacije</h4>

            <div class="d-flex gap-3 mb-4">
                <div class="rounded-circle bg-primary bg-opacity-10 p-3 flex-shrink-0">
                    <i class="bi bi-geo-alt text-primary fs-5"></i>
                </div>
                <div>
                    <div class="fw-semibold">Adresa</div>
                    <div class="text-muted">Bulevar Oslobođenja 12<br>21000 Novi Sad, Srbija</div>
                </div>
            </div>

            <div class="d-flex gap-3 mb-4">
                <div class="rounded-circle bg-success bg-opacity-10 p-3 flex-shrink-0">
                    <i class="bi bi-telephone text-success fs-5"></i>
                </div>
                <div>
                    <div class="fw-semibold">Telefon</div>
                    <div class="text-muted">+381 21 123 456<br>+381 64 123 456</div>
                </div>
            </div>

            <div class="d-flex gap-3 mb-4">
                <div class="rounded-circle bg-warning bg-opacity-10 p-3 flex-shrink-0">
                    <i class="bi bi-envelope text-warning fs-5"></i>
                </div>
                <div>
                    <div class="fw-semibold">Email</div>
                    <div class="text-muted">info@klinika.rs<br>admin@klinika.rs</div>
                </div>
            </div>

            <div class="d-flex gap-3">
                <div class="rounded-circle bg-info bg-opacity-10 p-3 flex-shrink-0">
                    <i class="bi bi-clock text-info fs-5"></i>
                </div>
                <div>
                    <div class="fw-semibold">Radno vreme</div>
                    <div class="text-muted">
                        Ponedeljak – Petak: 08:00 – 16:00<br>
                        Subota: 08:00 – 12:00<br>
                        Nedelja: Zatvoreno
                    </div>
                </div>
            </div>
        </div>

        {# Kontakt forma #}
        <div class="col-md-7">
            <h4 class="fw-bold mb-4">Pošaljite poruku</h4>
            <div class="alert alert-info">
                <i class="bi bi-info-circle me-2"></i>
                Za brži odgovor, prijavite se na sistem i pošaljite poruku direktno menadžeru klinike.
                <a href="{{ app_url }}/login" class="alert-link">Prijavite se</a>
            </div>

            <form>
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Ime</label>
                        <input type="text" class="form-control" placeholder="Vaše ime">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Prezime</label>
                        <input type="text" class="form-control" placeholder="Vaše prezime">
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input type="email" class="form-control" placeholder="vasa@email.com">
                </div>
                <div class="mb-3">
                    <label class="form-label">Poruka</label>
                    <textarea class="form-control" rows="4" placeholder="Vaša poruka..."></textarea>
                </div>
                <button type="button" class="btn btn-primary" onclick="alert('Za slanje poruke, molimo prijavite se na sistem.')">
                    <i class="bi bi-send me-1"></i> Pošaljite poruku
                </button>
            </form>
        </div>

    </div>

</div>

{% endblock %}
