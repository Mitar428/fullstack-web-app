{% extends 'layouts/guest.html.twig' %}

{% block title %}Dobrodošli — {{ app_name }}{% endblock %}

{% block content %}

{# HERO SEKCIJA #}
<div class="hero text-center">
    <div class="container">
        <h1 class="display-4 fw-bold mb-3">
            <i class="bi bi-hospital me-3"></i>{{ app_name }}
        </h1>
        <p class="lead mb-4">
            Vaše zdravlje je naš prioritet. Zakažite pregled online u nekoliko klikova.
        </p>
        <div class="d-flex gap-3 justify-content-center">
            <a href="{{ app_url }}/" class="btn btn-light btn-lg">
                <i class="bi bi-calendar-plus me-2"></i>Zakažite pregled
            </a>
            <a href="{{ app_url }}/lekari" class="btn btn-outline-light btn-lg">
                <i class="bi bi-people me-2"></i>Naši lekari
            </a>
        </div>
    </div>
</div>

{# USLUGE #}
<div class="container py-5">
    <h2 class="text-center fw-bold mb-5">Naše usluge</h2>
    <div class="row g-4">

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100 text-center p-3">
                <div class="card-body">
                    <i class="bi bi-heart-pulse text-primary fs-1 mb-3"></i>
                    <h5 class="fw-bold">Kardiologija</h5>
                    <p class="text-muted">Dijagnostika i lečenje bolesti srca i krvnih sudova.</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100 text-center p-3">
                <div class="card-body">
                    <i class="bi bi-ear text-success fs-1 mb-3"></i>
                    <h5 class="fw-bold">ORL</h5>
                    <p class="text-muted">Bolesti uho, grlo, nos.</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100 text-center p-3">
                <div class="card-body">
                    <i class="bi bi-clipboard2-pulse text-warning fs-1 mb-3"></i>
                    <h5 class="fw-bold">Opšta medicina</h5>
                    <p class="text-muted">Primarna zdravstvena zaštita i opšti pregledi.</p>
                </div>
            </div>
        </div>

    </div>
</div>

{# ZAŠTO MI #}
<div class="bg-light py-5">
    <div class="container">
        <h2 class="text-center fw-bold mb-5">Zašto izabrati nas?</h2>
        <div class="row g-4 text-center">
            <div class="col-md-3">
                <i class="bi bi-clock text-primary fs-2 mb-2"></i>
                <h6 class="fw-bold">Brzo zakazivanje</h6>
                <p class="text-muted small">Online zakazivanje 24/7</p>
            </div>
            <div class="col-md-3">
                <i class="bi bi-person-badge text-success fs-2 mb-2"></i>
                <h6 class="fw-bold">Stručni lekari</h6>
                <p class="text-muted small">Tim iskusnih specijalista</p>
            </div>
            <div class="col-md-3">
                <i class="bi bi-shield-check text-warning fs-2 mb-2"></i>
                <h6 class="fw-bold">Sigurnost podataka</h6>
                <p class="text-muted small">Vaši podaci su zaštićeni</p>
            </div>
            <div class="col-md-3">
                <i class="bi bi-geo-alt text-danger fs-2 mb-2"></i>
                <h6 class="fw-bold">Laka dostupnost</h6>
                <p class="text-muted small">Centralna lokacija u gradu</p>
            </div>
        </div>
    </div>
</div>

{% endblock %}