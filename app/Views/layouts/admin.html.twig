<!DOCTYPE html>
<html lang="sr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Admin Panel — {{ app_name }}{% endblock %}</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        .sidebar { min-height: 100vh; background: #1a3c5e; width: 250px; }
        .sidebar .nav-link { color: #adb5bd; padding: 10px 20px; }
        .sidebar .nav-link:hover { color: #fff; background: rgba(255,255,255,0.1); }
        .sidebar .nav-link.active { color: #fff; background: #0d6efd; }
        .sidebar .nav-link i { width: 20px; }
        .sidebar-brand { color: #fff; font-size: 1.1rem; padding: 20px; border-bottom: 1px solid rgba(255,255,255,0.1); }
        .main-content { flex: 1; background: #f8f9fa; min-height: 100vh; }
        .topbar { background: #fff; border-bottom: 1px solid #dee2e6; padding: 12px 24px; }
    </style>
    {% block styles %}{% endblock %}
</head>
<body>
<div class="d-flex">

    {# SIDEBAR #}
    <div class="sidebar d-flex flex-column">
        <div class="sidebar-brand">
            <i class="bi bi-hospital me-2"></i>{{ app_name }}
            <div style="font-size:0.75rem; color:#6c757d;">Administrator</div>
        </div>

        <nav class="nav flex-column mt-2">
            <a href="{{ app_url }}/admin" class="nav-link">
                <i class="bi bi-speedometer2"></i> Dashboard
            </a>
            <a href="{{ app_url }}/admin/korisnici" class="nav-link">
                <i class="bi bi-people"></i> Korisnici
            </a>
            <a href="{{ app_url }}/admin/lekari" class="nav-link">
                <i class="bi bi-person-badge"></i> Lekari
            </a>
            <a href="{{ app_url }}/admin/pacijenti" class="nav-link">
                <i class="bi bi-person-heart"></i> Pacijenti
            </a>
            <a href="{{ app_url }}/admin/termini" class="nav-link">
                <i class="bi bi-calendar3"></i> Termini
            </a>
            <a href="{{ app_url }}/admin/dijagnoze" class="nav-link">
                <i class="bi bi-clipboard2-pulse"></i> Dijagnoze
            </a>
            <a href="{{ app_url }}/admin/izvestaji" class="nav-link">
                <i class="bi bi-file-earmark-bar-graph"></i> Izveštaji
            </a>
            <a href="{{ app_url }}/admin/log" class="nav-link">
                <i class="bi bi-journal-text"></i> Activity Log
            </a>

            <hr style="border-color: rgba(255,255,255,0.1);">

            <a href="{{ app_url }}/logout" class="nav-link text-danger">
                <i class="bi bi-box-arrow-left"></i> Odjava
            </a>
        </nav>
    </div>

    {# MAIN CONTENT #}
    <div class="main-content d-flex flex-column w-100">

        {# TOPBAR #}
        <div class="topbar d-flex justify-content-between align-items-center">
            <h6 class="mb-0">{% block page_title %}Dashboard{% endblock %}</h6>
            <div class="d-flex align-items-center gap-3">
                <span class="text-muted small">
                    <i class="bi bi-person-circle me-1"></i>
                    {{ session.user_name }}
                </span>
                <span class="badge bg-danger">Admin</span>
            </div>
        </div>

        {# FLASH PORUKE #}
        <div class="px-4 pt-3">
            {% if flash.success %}
                <div class="alert alert-success alert-dismissible fade show">
                    {{ flash.success }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endif %}
            {% if flash.error %}
                <div class="alert alert-danger alert-dismissible fade show">
                    {{ flash.error }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endif %}
        </div>

        {# PAGE CONTENT #}
        <div class="p-4 flex-grow-1">
            {% block content %}{% endblock %}
        </div>

    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
{% block scripts %}{% endblock %}
</body>
</html>