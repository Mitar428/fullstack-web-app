<!DOCTYPE html>
<html lang="sr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}{{ app_name }}{% endblock %}</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        .navbar-brand { font-weight: 700; color: #1a3c5e !important; }
        .hero { background: linear-gradient(135deg, #1a3c5e, #0d6efd); color: white; padding: 100px 0; }
        footer { background: #1a3c5e; color: #adb5bd; }
    </style>
    {% block styles %}{% endblock %}
</head>
<body>

    {# NAVIGACIJA #}
    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm">
        <div class="container">
            <a class="navbar-brand" href="{{ app_url }}/">
                <i class="bi bi-hospital me-2 text-primary"></i>{{ app_name }}
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navMenu">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="{{ app_url }}/">Početna</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ app_url }}/o-nama">O nama</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ app_url }}/lekari">Naši lekari</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ app_url }}/kontakt">Kontakt</a>
                    </li>
                </ul>
                <div class="d-flex gap-2">
                    <a href="{{ app_url }}/login" class="btn btn-outline-primary">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Prijava
                    </a>
                    <a href="{{ app_url }}/register" class="btn btn-primary">
                        <i class="bi bi-person-plus me-1"></i> Registracija
                    </a>
                </div>
            </div>
        </div>
    </nav>

    {# SADRŽAJ STRANICE #}
    {% block content %}{% endblock %}

    {# FOOTER #}
    <footer class="py-4 mt-5">
        <div class="container text-center">
            <p class="mb-0">© 2026 {{ app_name }}. Sva prava zadržana.</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    {% block scripts %}{% endblock %}
</body>
</html>