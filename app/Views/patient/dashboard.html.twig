{% extends 'layouts/patient.html.twig'%}

{% block page_title %}Moj nalog{% endblock %}

{% block content %}

{% if not pacijent %}
<div class="alert alert-warning">
    <i class="bi bi-exclamation-triangle me-2"></i>
    Vaš pacijentski profil još uvek nije kreiran. Kontaktirajte administraciju klinike.
</div>
{% endif %}

<div class="row g-4 mb-4">

    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle bg-primary bg-opacity-10 p-3">
                    <i class="bi bi-calendar3 text-primary fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small">Predstojeći termini</div>
                    <div class="fs-4 fw-bold">{{ predstojeciTermini|length }}</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle bg-warning bg-opacity-10 p-3">
                    <i class="bi bi-envelope text-warning fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small">Nepročitane poruke</div>
                    <div class="fs-4 fw-bold">{{ neprocitanePoruke }}</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle bg-success bg-opacity-10 p-3">
                    <i class="bi bi-calendar-plus text-success fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small">Zakažite pregled</div>
                    <a href="{{ app_url }}/pacijent/termini/novi" class="btn btn-sm btn-success mt-1">
                        Zakaži
                    </a>
                </div>
            </div>
        </div>
    </div>

</div>

{# Predstojeći termini #}
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white fw-semibold">
        <i class="bi bi-calendar-event me-2"></i>Predstojeći termini
    </div>
    <div class="card-body p-0">
        {% if predstojeciTermini|length > 0 %}
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Lekar</th>
                    <th>Specijalnost</th>
                    <th>Datum i vreme</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                {% for t in predstojeciTermini %}
                <tr>
                    <td>{{ t.doctor_name }}</td>
                    <td><span class="badge bg-info text-dark">{{ t.specialization }}</span></td>
                    <td>{{ t.scheduled_at|date('d.m.Y H:i') }}</td>
                    <td>
                        {% if t.status == 'pending' %}
                            <span class="badge bg-warning text-dark">Na čekanju</span>
                        {% elseif t.status == 'confirmed' %}
                            <span class="badge bg-success">Potvrđen</span>
                        {% endif %}
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        {% else %}
        <div class="text-center text-muted py-5">
            <i class="bi bi-calendar-x fs-1 d-block mb-2"></i>
            Nemate predstojeće termine.
            <div class="mt-2">
                <a href="{{ app_url }}/pacijent/termini/novi" class="btn btn-primary btn-sm">
                    Zakažite pregled
                </a>
            </div>
        </div>
        {% endif %}
    </div>
</div>

{% endblock %}
