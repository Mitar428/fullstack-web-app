{% extends 'layouts/admin.html.twig' %}

{% block page_title %}Dashboard{% endblock %}

{% block content %}

<div class="row g-4 mb-4">

    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle bg-primary bg-opacity-10 p-3">
                    <i class="bi bi-people text-primary fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small">Ukupno korisnika</div>
                    <div class="fs-4 fw-bold">{{ stats.korisnici }}</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle bg-success bg-opacity-10 p-3">
                    <i class="bi bi-calendar-check text-success fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small">Termini danas</div>
                    <div class="fs-4 fw-bold">{{ stats.termini_danas }}</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle bg-info bg-opacity-10 p-3">
                    <i class="bi bi-person-badge text-info fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small">Lekari</div>
                    <div class="fs-4 fw-bold">{{ stats.lekari }}</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle bg-warning bg-opacity-10 p-3">
                    <i class="bi bi-person-heart text-warning fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small">Pacijenti</div>
                    <div class="fs-4 fw-bold">{{ stats.pacijenti }}</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle bg-danger bg-opacity-10 p-3">
                    <i class="bi bi-hourglass-split text-danger fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small">Na čekanju</div>
                    <div class="fs-4 fw-bold">{{ stats.termini_pending }}</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-circle bg-secondary bg-opacity-10 p-3">
                    <i class="bi bi-calendar3 text-secondary fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small">Ukupno termina</div>
                    <div class="fs-4 fw-bold">{{ stats.termini_ukupno }}</div>
                </div>
            </div>
        </div>
    </div>

</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white fw-semibold">
        <i class="bi bi-lightning-charge me-2"></i>Brze akcije
    </div>
    <div class="card-body">
        <a href="{{ app_url }}/admin/korisnici" class="btn btn-outline-primary me-2 mb-2">
            <i class="bi bi-people me-1"></i> Korisnici
        </a>
        <a href="{{ app_url }}/admin/lekari" class="btn btn-outline-info me-2 mb-2">
            <i class="bi bi-person-badge me-1"></i> Lekari
        </a>
        <a href="{{ app_url }}/admin/pacijenti" class="btn btn-outline-warning me-2 mb-2">
            <i class="bi bi-person-heart me-1"></i> Pacijenti
        </a>
        <a href="{{ app_url }}/admin/termini" class="btn btn-outline-success me-2 mb-2">
            <i class="bi bi-calendar3 me-1"></i> Termini
        </a>
        <a href="{{ app_url }}/admin/izvestaji" class="btn btn-outline-secondary me-2 mb-2">
            <i class="bi bi-file-earmark-bar-graph me-1"></i> Izveštaji
        </a>
        <a href="{{ app_url }}/admin/log" class="btn btn-outline-dark me-2 mb-2">
            <i class="bi bi-journal-text me-1"></i> Activity Log
        </a>
    </div>
</div>

{% endblock %}
