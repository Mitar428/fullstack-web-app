{% extends 'layouts/admin.html.twig' %}

{% block page_title %}Activity Log{% endblock %}

{% block content %}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0">Activity Log</h5>
    <span class="badge bg-secondary">Poslednjih {{ logovi|length }} zapisa</span>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white fw-semibold">
        <i class="bi bi-journal-text me-2"></i>Korisničke akcije
    </div>
    <div class="card-body p-0">
        <table class="table table-hover mb-0 small">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Korisnik</th>
                    <th>Akcija</th>
                    <th>Entitet</th>
                    <th>IP adresa</th>
                    <th>Detalji</th>
                    <th>Datum i vreme</th>
                </tr>
            </thead>
            <tbody>
                {% for log in logovi %}
                <tr>
                    <td class="text-muted">{{ log.id }}</td>
                    <td>
                        {% if log.user_name %}
                            <span class="fw-semibold">{{ log.user_name }}</span>
                            <div class="text-muted" style="font-size:0.75rem;">{{ log.user_email }}</div>
                        {% else %}
                            <span class="text-muted">Gost/Sistem</span>
                        {% endif %}
                    </td>
                    <td><code class="text-primary">{{ log.action }}</code></td>
                    <td>
                        {% if log.entity_type %}
                            <span class="badge bg-light text-dark border">{{ log.entity_type }}</span>
                            {% if log.entity_id %}
                                <span class="text-muted">#{{ log.entity_id }}</span>
                            {% endif %}
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endif %}
                    </td>
                    <td class="text-muted">{{ log.ip_address ?? '—' }}</td>
                    <td>
                        {% if log.details %}
                            <code class="text-muted" style="font-size:0.75rem;">{{ log.details }}</code>
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endif %}
                    </td>
                    <td class="text-muted">{{ log.created_at|date('d.m.Y H:i:s') }}</td>
                </tr>
                {% else %}
                <tr><td colspan="7" class="text-center text-muted py-4">Nema zapisa u logu.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

{% endblock %}
