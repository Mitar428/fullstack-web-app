{% extends 'layouts/admin.html.twig' %}

{% block page_title %}Izveštaji{% endblock %}

{% block content %}

<div class="mb-4">
    <h5 class="mb-0">Izveštaji i statistike</h5>
</div>

{# Kartice sa statistikama #}
<div class="row g-4 mb-4">

    <div class="col-md-4">
        <div class="card border-0 shadow-sm text-center">
            <div class="card-body py-4">
                <i class="bi bi-calendar3 text-primary fs-2 mb-2"></i>
                <div class="fs-3 fw-bold text-primary">{{ stats.ukupno_termina }}</div>
                <div class="text-muted">Ukupno termina</div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm text-center">
            <div class="card-body py-4">
                <i class="bi bi-check-circle text-success fs-2 mb-2"></i>
                <div class="fs-3 fw-bold text-success">{{ stats.zavrseni }}</div>
                <div class="text-muted">Završenih termina</div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm text-center">
            <div class="card-body py-4">
                <i class="bi bi-x-circle text-danger fs-2 mb-2"></i>
                <div class="fs-3 fw-bold text-danger">{{ stats.otkazani }}</div>
                <div class="text-muted">Otkazanih termina</div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm text-center">
            <div class="card-body py-4">
                <i class="bi bi-hourglass-split text-warning fs-2 mb-2"></i>
                <div class="fs-3 fw-bold text-warning">{{ stats.pending }}</div>
                <div class="text-muted">Na čekanju</div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm text-center">
            <div class="card-body py-4">
                <i class="bi bi-person-heart text-info fs-2 mb-2"></i>
                <div class="fs-3 fw-bold text-info">{{ stats.ukupno_pacijenata }}</div>
                <div class="text-muted">Ukupno pacijenata</div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-0 shadow-sm text-center">
            <div class="card-body py-4">
                <i class="bi bi-person-badge fs-2 mb-2" style="color:#6f42c1;"></i>
                <div class="fs-3 fw-bold" style="color:#6f42c1;">{{ stats.ukupno_lekara }}</div>
                <div class="text-muted">Ukupno lekara</div>
            </div>
        </div>
    </div>

</div>

{# Tabela statusa termina #}
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white fw-semibold">
        <i class="bi bi-bar-chart me-2"></i>Pregled statusa termina
    </div>
    <div class="card-body">
        <table class="table table-bordered text-center mb-0">
            <thead class="table-light">
                <tr>
                    <th>Status</th>
                    <th>Broj termina</th>
                    <th>Procenat</th>
                </tr>
            </thead>
            <tbody>
                {% set ukupno = stats.ukupno_termina > 0 ? stats.ukupno_termina : 1 %}
                <tr>
                    <td><span class="badge bg-warning text-dark">Na čekanju</span></td>
                    <td>{{ stats.pending }}</td>
                    <td>{{ ((stats.pending / ukupno) * 100)|round(1) }}%</td>
                </tr>
                <tr>
                    <td><span class="badge bg-success">Potvrđeni</span></td>
                    <td>{{ stats.confirmed }}</td>
                    <td>{{ ((stats.confirmed / ukupno) * 100)|round(1) }}%</td>
                </tr>
                <tr>
                    <td><span class="badge bg-info text-dark">Završeni</span></td>
                    <td>{{ stats.zavrseni }}</td>
                    <td>{{ ((stats.zavrseni / ukupno) * 100)|round(1) }}%</td>
                </tr>
                <tr>
                    <td><span class="badge bg-danger">Otkazani</span></td>
                    <td>{{ stats.otkazani }}</td>
                    <td>{{ ((stats.otkazani / ukupno) * 100)|round(1) }}%</td>
                </tr>
                <tr>
                    <td><span class="badge bg-secondary">Nije se pojavio</span></td>
                    <td>{{ stats.no_show }}</td>
                    <td>{{ ((stats.no_show / ukupno) * 100)|round(1) }}%</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

{% endblock %}
