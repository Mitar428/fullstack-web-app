{% extends 'layouts/admin.html.twig' %}

{% block page_title %}Upravljanje korisnicima{% endblock %}

{% block content %}

{# 21.06.2026. - dodato dugme za dodavanje korisnika #}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0">Svi korisnici</h5>
    <a href="{{ app_url }}/admin/korisnici/novi" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> Dodaj korisnika
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <span class="fw-semibold">
            <i class="bi bi-people me-2"></i>Svi korisnici
        </span>
    </div>
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Ime i prezime</th>
                    <th>Email</th>
                    <th>Uloga</th>
                    <th>Status</th>
                    <th>Registrovan</th>
                    {# 21.06.2026. - dodata kolona za akcije #}
                    <th class="text-end">Akcije</th>
                </tr>
            </thead>
            <tbody>
                {% for user in korisnici %}
                <tr>
                    <td>{{ user.id }}</td>
                    <td>{{ user.first_name }} {{ user.last_name }}</td>
                    <td>{{ user.email }}</td>
                    <td>
                        {% if user.role_slug == 'admin' %}
                            <span class="badge bg-danger">Admin</span>
                        {% elseif user.role_slug == 'manager' %}
                            <span class="badge bg-warning text-dark">Menadžer/Doktor</span>
                        {% else %}
                            <span class="badge bg-info">Pacijent</span>
                        {% endif %}
                    </td>
                    <td>
                        {% if user.is_active %}
                            <span class="badge bg-success">Aktivan</span>
                        {% else %}
                            <span class="badge bg-secondary">Neaktivan</span>
                        {% endif %}
                    </td>
                    <td>{{ user.created_at|date('d.m.Y') }}</td>
                    {# 21.06.2026. - start: dugmići za izmenu i brisanje #}
                    <td class="text-end">
                        <a href="{{ app_url }}/admin/korisnici/{{ user.id }}/izmeni" 
                           class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <form action="{{ app_url }}/admin/korisnici/{{ user.id }}/obrisi" 
                              method="POST" class="d-inline"
                              onsubmit="return confirm('Da li ste sigurni da želite da obrišete korisnika?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </td>
                    {# 21.06.2026. - end #}
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

{% endblock %}